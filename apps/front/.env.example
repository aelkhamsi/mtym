NEXT_PUBLIC_API_ENDPOINT='http://localhost:5000'
NEXT_PUBLIC_SMTP_ENDPOINT='http://localhost:9999'
NEXT_PUBLIC_CLOSE_APPLICATIONS='false'

# Payload upload storage (MinIO / S3-compatible).
# Leave MINIO_ENDPOINT unset to store uploads on local disk instead.
# Reuses the same MinIO instance/credentials as the API.
MINIO_ENDPOINT='http://localhost:9000'
MINIO_BUCKET_NAME='mtym-s3'
MINIO_REGION='us-east-1'
MINIO_ROOT_USER='root'
MINIO_ROOT_PASSWORD='password'

PAYLOAD_SECRET=some_long_random_string_here
DATABASE_URL=file:./payload.db
